# API Keys - Get free keys from:
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# Financial Modeling Prep: https://site.financialmodelingprep.com/developer/docs/

ALPHA_VANTAGE_API_KEY=your_key_here
FMP_API_KEY=your_key_here

# SEC EDGAR User-Agent (required by SEC)
# Format: CompanyName ContactEmail
SEC_USER_AGENT=YourCompany your.email@example.com

# Cache settings
CACHE_TTL_QUOTES=300
CACHE_TTL_FUNDAMENTALS=86400
CACHE_TTL_FILINGS=604800

# Rate limits (requests per minute)
ALPHA_VANTAGE_RATE_LIMIT=5
FMP_RATE_LIMIT=300
SEC_RATE_LIMIT=10

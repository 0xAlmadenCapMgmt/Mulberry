# Mulberry configuration
# All data comes from Yahoo Finance — no API key required.

# Cache settings (seconds)
CACHE_TTL_QUOTES=300
CACHE_TTL_FUNDAMENTALS=86400
CACHE_TTL_FILINGS=604800

# Valuation parameters
# AAA corporate bond yield (percent) used in the growth-adjusted earnings formula
AAA_BOND_YIELD=5.0

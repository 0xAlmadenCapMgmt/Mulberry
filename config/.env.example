# Mulberry configuration
# Core price/fundamentals data comes from Yahoo Finance — no API key required.

# Cache settings (seconds)
CACHE_TTL_FUNDAMENTALS=86400
CACHE_TTL_FILINGS=604800

# SEC EDGAR (used by the filings section — no API key, just a contact string).
# SEC etiquette asks for a descriptive User-Agent with a real email.
SEC_USER_AGENT=YourName your.email@example.com

# Valuation parameters
# AAA corporate bond yield (percent) used in the growth-adjusted earnings formula
AAA_BOND_YIELD=5.0
